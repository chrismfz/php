diff -Naur a/ext/standard/tests/http/ghsa-hgf5-96fm-v528-003.phpt b/ext/standard/tests/http/ghsa-hgf5-96fm-v528-003.phpt
--- a/ext/standard/tests/http/ghsa-hgf5-96fm-v528-003.phpt	1970-01-01 01:00:00.000000000 +0100
+++ b/ext/standard/tests/http/ghsa-hgf5-96fm-v528-003.phpt	2026-09-03 12:46:16.951639951 +0200
@@ -0,0 +1,34 @@
+--TEST--
+GHSA-hgf5-96fm-v528: Header parser of http stream wrapper does not handle folded headers (correct middle pos)
+--INI--
+allow_url_fopen=1
+--SKIPIF--
+<?php require 'server.inc'; http_server_skipif('tcp://127.0.0.1:12342'); ?>
+--FILE--
+<?php
+require 'server.inc';
+
+$options = [
+    'http' => [
+        'method' => 'GET',
+        'header' => "Cookie: x=y\r\nAuthorization: Bearer x\r\n",
+    ],
+];
+$ctx = stream_context_create($options);
+$responses = ["data://text/plain,HTTP/1.1 200\r\nConnection: close\r\n\r\nOK"];
+
+$pid = http_server('tcp://127.0.0.1:12342', $responses, $output);
+@file_get_contents('http://user:pwd@127.0.0.1:12342/', false, $ctx);
+fseek($output, 0, SEEK_SET);
+echo stream_get_contents($output);
+http_server_kill($pid);
+?>
+Done
+--EXPECT--
+GET / HTTP/1.0
+Host: 127.0.0.1:12342
